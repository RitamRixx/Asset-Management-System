# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=ams_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ams_db

# --- Backend ---
# Must match the Postgres values above; the compose file wires this
# automatically, but it's also read directly by app/core/config.py
# when running the backend outside Docker.
DATABASE_URL=postgresql+psycopg2://ams_user:change_me@localhost:5432/ams_db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:3000"]

# --- Email (optional; notifications work in-app only if this is left disabled) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@ams-platform.local
SMTP_FROM_NAME=AMS Platform

# --- Microsoft Entra ID / Microsoft 365 SSO ---
# Disabled by default. Enable only after the Entra app registration
# and OIDC configuration are completed.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_ALLOWED_TENANT_ID=
FRONTEND_BASE_URL=http://localhost:3000
